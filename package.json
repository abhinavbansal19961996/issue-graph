{
  "name": "gh-graph",
  "version": "0.5.0",
  "description": "Snapshot and trace the full reference graph of a GitHub PR or issue — comments, linked PRs, cross-referenced issues, closing refs, and external links, recursively across repos.",
  "type": "module",
  "bin": {
    "gh-graph": "./src/cli.ts"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "start": "bun run src/cli.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src",
    "lint:fix": "biome check --write src",
    "format": "biome format --write src"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "files": [
    "src",
    "skills"
  ],
  "keywords": [
    "github",
    "cli",
    "pull-request",
    "issue",
    "reference-graph",
    "agent",
    "triage"
  ],
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  }
}
